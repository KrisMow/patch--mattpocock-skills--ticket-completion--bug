# Shared by every script (bash + PowerShell). Plain KEY=value lines, no quoting.
# Where the plugin lives, relative to the Claude config dir (~/.claude or %USERPROFILE%\.claude):
PLUGIN_CACHE_GLOB=plugins/cache/*/mattpocock-skills/*
# Environment variable that overrides the install dir (point it at one version dir):
OVERRIDE_ENV=MATTPOCOCK_SKILLS_DIR
# Marker format written around every inserted block: <!-- mp-patch:<fragment> begin|end -->
MARKER_PREFIX=mp-patch
